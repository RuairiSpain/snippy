# Copy to .env (git-ignored). Values below are placeholders.
# Secrets are NOT stored here: set the *_SECRET_NAME variables to Key Vault secret names.

# --- Azure deployment ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=westeurope
AZURE_ENV_NAME=euaiaction-dev
AZURE_RESOURCE_GROUP=
AZURE_OPENAI_LOCATION=swedencentral

# --- Application ---
APP_ENV=dev
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en

# --- Customer Microsoft tenant to scan (collector app registration) ---
TARGET_TENANT_ID=
COLLECTOR_CLIENT_ID=
COLLECTOR_CLIENT_SECRET_NAME=collector-client-secret
DATAVERSE_ENVIRONMENT_URL=
GRAPH_BASE_URL=https://graph.microsoft.com
GRAPH_API_VERSION=beta
PURVIEW_AUDIT_ENABLED=true

# --- Storage ---
COSMOS_ENDPOINT=
COSMOS_DATABASE=euaiaction
STORAGE_ACCOUNT_NAME=
DOCUMENTS_CONTAINER=documents

# --- LLM ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
LLM_TEMPERATURE=0
NARRATIVE_ENABLED=true

# --- Key Vault ---
KEY_VAULT_NAME=

# --- Portal and auth ---
PORTAL_ENTRA_CLIENT_ID=
PORTAL_ALLOWED_TENANT_IDS=

# --- Rules and documents ---
RULES_DIR=src/rules/content
TEMPLATES_DIR=src/documents/templates
REQUIRE_COUNSEL_REVIEW_FOR_RELEASE=true

# --- Local development and tests ---
USE_FIXTURES=false
FIXTURES_DIR=tests/fixtures
